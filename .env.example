# ================================================
# AI 赚钱案例库 - 环境变量配置
# 复制此文件为 .env.local 并填入你的真实值
# ================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 生产环境改为你的域名，例如: https://your-app.vercel.app

# ---- Supabase ----
# 从 https://supabase.com/dashboard → Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ⚠️ SERVICE_ROLE_KEY 绝对不能暴露到前端！

# ---- OpenRouter (支持多模型) ----
# 从 https://openrouter.ai/settings keys 获取
OPENROUTER_API_KEY=your-openrouter-api-key

# ---- Stripe (国际支付) ----
# 从 https://dashboard.stripe.com/apikeys 获取
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# 在 Stripe Dashboard → Products 创建价格后填入
STRIPE_PRO_MONTHLY_PRICE_ID=price_your-monthly-price-id
STRIPE_PRO_YEARLY_PRICE_ID=price_your-yearly-price-id

# ---- 虎皮椒支付 (国内支付，个人开发者可用) ----
# 注册地址: https://www.xunhupay.com/
# 在 后台 → 应用管理 获取
XUNHUPAY_APP_ID=your-app-id
XUNHUPAY_APP_SECRET=your-app-secret
